# ==============================================================================
# Laravel Root .htaccess (Production & Shared Hosting Ready)
# Project: PanduYuk Transit Intelligence & WebGIS
# ==============================================================================

<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews
    </IfModule>

    RewriteEngine On
    RewriteBase /
    CGIPassAuth On

    # --------------------------------------------------------------------------
    # 1. SECURITY: Block direct web access to sensitive project files
    # --------------------------------------------------------------------------
    RewriteRule ^(\.env|\.git|artisan|composer\.(json|lock)|package(-lock)?\.json|phpunit\.xml|vite\.config\.js|\.user\.ini|php\.ini) - [F,L,NC]
    
    # Block direct access to internal Laravel directories
    RewriteRule ^(app|bootstrap|config|database|resources|routes|tests|vendor)/ - [F,L,NC]

    # Block sensitive storage subdirectories (preserve public uploads in public/storage)
    RewriteRule ^storage/(app|framework|logs)/ - [F,L,NC]

    # --------------------------------------------------------------------------
    # 2. AUTHENTICATION: Preserve Authorization Header (Bearer / Sanctum Tokens)
    # --------------------------------------------------------------------------
    <IfModule mod_setenvif.c>
        SetEnvIfNoCase ^Authorization$ "(.+)" HTTP_AUTHORIZATION=$1
    </IfModule>
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # --------------------------------------------------------------------------
    # 3. ROUTING: Forward all incoming traffic smoothly into the /public directory
    # --------------------------------------------------------------------------
    # Remove /public/ from browser address bar if typed manually
    RewriteCond %{THE_REQUEST} /public/([^\s?]*) [NC]
    RewriteRule ^ %1 [L,NE,R=301]

    # Forward all other requests to public folder
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L,QSA]
</IfModule>

# ------------------------------------------------------------------------------
# 4. HARDEN SECURITY: Deny access to sensitive files
# ------------------------------------------------------------------------------
<FilesMatch "^(\.env|\.git|composer|artisan|package|\.user\.ini|php\.ini)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Disable Directory Browsing safely without throwing 500 error
<IfModule mod_autoindex.c>
    Options -Indexes
</IfModule>
