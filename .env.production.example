# ==============================================================================
# PanduYuk Transit Intelligence - Production Environment Configuration Template
# Salin file ini menjadi .env di server hosting Anda:
# cp .env.production.example .env (atau rename di File Manager cPanel)
# ==============================================================================

APP_NAME="PanduYuk"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Jakarta
APP_URL=https://namadomain-anda.com

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ------------------------------------------------------------------------------
# DATABASE CONFIGURATION (MySQL / MariaDB untuk cPanel / Shared Hosting)
# Buat Database & User di cPanel MySQL Database Wizard
# ------------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=usernamecpanel_panduyuk
DB_USERNAME=usernamecpanel_panduyukuser
DB_PASSWORD="PasswordKuatDatabase123!"

# Jika ingin tetap menggunakan SQLite di hosting:
# DB_CONNECTION=sqlite
# Pastikan file database/database.sqlite ada dan permissions folder database/ adalah 775/777

# ------------------------------------------------------------------------------
# SESSION & CACHE CONFIGURATION
# ------------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=panduyuk_cache_

# ------------------------------------------------------------------------------
# MAIL CONFIGURATION (SMTP Hosting / cPanel Webmail)
# ------------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=mail.namadomain-anda.com
MAIL_PORT=465
MAIL_USERNAME=noreply@namadomain-anda.com
MAIL_PASSWORD="PasswordEmailAnda"
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="noreply@namadomain-anda.com"
MAIL_FROM_NAME="${APP_NAME}"

# ------------------------------------------------------------------------------
# TRANSIT INTELLIGENCE & GTFS REALTIME CONFIGURATION
# ------------------------------------------------------------------------------
GTFS_RT_URL=
GTFS_RT_API_KEY=
GTFS_RT_CACHE_SECONDS=15
GTFS_RT_ARRIVAL_RADIUS_METERS=

# ------------------------------------------------------------------------------
# GEMINI AI / THIRD-PARTY API
# ------------------------------------------------------------------------------
GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# HOSTING MAINTENANCE SECRET KEY (Untuk Shared Hosting tanpa Terminal/SSH)
# Digunakan untuk mengakses /system/maintenance?action=...&key=KUNCI_INI
# ------------------------------------------------------------------------------
ARTISAN_MAINTENANCE_KEY=panduyuk_secret_maintenance_key_ganti_ini

